# 1. Block secrets — .env files must never be committed
if git diff --cached --name-only | grep -Eq '(^\.env$|\.env\.local$|\.env\..*\.local$)'; then
  echo "BLOCKED: .env files must not be committed. Unstage them and commit again."
  exit 1
fi

# 2. Scan staged content for leaked secret values/patterns
node scripts/scan-secrets.mjs || exit 1

# 3. Format/lint staged files (no-stash: lint-staged stash/restore breaks on Windows)
npx lint-staged --no-stash || exit 1

# 4. Typecheck
npx tsc --noEmit || exit 1

# 5. Unit tests with coverage gate
npm run test:coverage || exit 1

# 6. ORM schema must stay valid
npx prisma validate || exit 1
