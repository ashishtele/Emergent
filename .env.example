# Emergent — public example. Copy to .env.local and fill in.
# Never commit real keys.

# Supabase (public, safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase (server-only, keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Postgres via Supabase poolers (URL-encode special chars in password)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-us-east-2.pooler.supabase.com:5432/postgres"

# OpenAlex (free key required since 2026; get from openalex.org/settings/api)
OPENALEX_API_KEY=your-openalex-key-here
OPENALEX_MAILTO=you@example.com
OPENALEX_BASE_URL=https://api.openalex.org

# AI (provider-agnostic, OpenAI-compatible; OpenRouter free models by default)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=your-ai-key-here
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
