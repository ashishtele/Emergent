{
  "version": "1.1",
  "_note": "All weights and thresholds live here. Bands are evaluated top-down; first match wins. 'high' = value >= threshold, 'low' = value <= threshold, 'range' = lo <= value <= hi.",
  "gates": {
    "_source": "RS80 scan (transcript 33:06-34:14 and 1:11:55): price > 200 DMA, RS 80-99, 30-day avg turnover >= 10 Cr (7 Cr soft floor), mcap > 500 Cr, price > Rs 10",
    "price_above_200dma": {
      "type": "bool"
    },
    "rs_rating": {
      "type": "min",
      "value": 80
    },
    "avg_turnover_30d_cr": {
      "type": "min",
      "value": 10,
      "soft_min": 7
    },
    "market_cap_cr": {
      "type": "min",
      "value": 500
    },
    "price": {
      "type": "min",
      "value": 10
    }
  },
  "pillars": {
