          "bands": [
            [26, 5],
            [8, 4],
            [4, 3],
            [0, 0]
          ]
        },
        "stop_distance_pct": {
          "max": 8,
          "type": "low",
          "bands": [
            [5, 8],
            [6, 7],
            [8, 5],
            [1000000000.0, 0]
          ]
        },
        "volume_dryup_ratio": {
          "max": 4,
          "type": "low",
          "bands": [
            [0.6, 4],
            [0.8, 3],
            [1.0, 1],
            [1000000000.0, 0]
          ]
        },
        "volume_spike_ratio": {
          "max": 3,
