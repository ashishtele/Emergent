  "caps": {
    "loose_base": {
      "field": "stop_distance_pct",
      "above": 8,
      "cap": 59,
      "msg": "Stop is more than 8% below the pivot: not a proper tight base. Wait for a tighter right side."
    },
    "theme_tourist": {
      "field": "theme_revenue_share_pct",
      "below": 10,
      "cap": 59,
      "msg": "The theme is under 10% of revenue (the 'Paramount: 2% of revenue from OFC' case). Price may trade on the theme but earnings won't follow."
    },
    "weak_vs_50ema": {
      "field": "ema50_breaches",
      "above": 1,
      "cap": 69,
      "msg": "Closed below the 50 EMA more than once during the advance; strong leaders usually don't."
